DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Hidden operator vault PIN (activation screen + sidebar).
# Open http://127.0.0.1:8501/?admin=1 then enter this PIN to issue keys.
LICENSE_ADMIN_PIN=g4a-royal-admin

# Optional extra salt for stored key hashes. Change before issuing production keys.
LICENSE_HMAC_SECRET=game4all-manager-pro

# SQLite path (use /tmp/game4all_manager.db on read-only/ephemeral hosts like Streamlit Cloud).
# G4A_DB_PATH=/tmp/game4all_manager.db

# Auto-import bundled sample_data/*.csv on empty inventory at startup (1=on, 0=off).
# G4A_AUTO_BOOTSTRAP=1
